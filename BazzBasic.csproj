<Project Sdk="Microsoft.NET.Sdk">

  <!-- BazzBasic interpreter (console). The IDE is IDE\BazzBasic-IDE.csproj.
       Shared metadata (version, company...) comes from Directory.Build.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- -windows is needed for System.Drawing.Common (LOADIMAGE/LOADSHEET).
         No UseWindowsForms: it would pull in the WindowsDesktop runtime (~40 MB). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>IDE0130;NU1510</NoWarn>

    <AssemblyName>BazzBasic</AssemblyName>
    <RootNamespace>BazzBasic</RootNamespace>
    <AssemblyTitle>BazzBasic</AssemblyTitle>
    <Description>BazzBasic BASIC interpreter</Description>

    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Trimming: ~72 MB -> ~15 MB. Compiled user programs are copies of this exe,
       so they shrink too. Keep the build free of IL2xxx trim warnings
       (e.g. JSON must not use reflection-based JsonSerializer). -->
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>

  <!-- The IDE project lives in IDE\ and must not be compiled into the interpreter -->
  <ItemGroup>
    <Compile Remove="IDE\**" />
    <EmbeddedResource Remove="IDE\**" />
    <None Remove="IDE\**" />
    <Content Remove="IDE\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SDL2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SDL2_mixer.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SDL2_ttf.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="docs\" />
  </ItemGroup>

  <!-- Clean up publish: remove win-x86 (not needed for x64 build) and .pdb -->
  <Target Name="CleanPublishOutput" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)runtimes\win-x86" Condition="Exists('$(PublishDir)runtimes\win-x86')" />
    <Delete Files="$(PublishDir)BazzBasic.pdb" Condition="Exists('$(PublishDir)BazzBasic.pdb')" />
  </Target>

</Project>
